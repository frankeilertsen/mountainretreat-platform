# --- Required ---
DATABASE_URL=postgres://postgres@localhost:5432/byrampen
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Used to encrypt TOTP secrets (AES-256-GCM). Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Separate random secret for hashing tokens (HMAC-SHA256)
TOKEN_PEPPER=
# Shared secret that protects /api/cron/* (send as header x-cron-secret)
CRON_SECRET=

# --- Email (Resend, EU region). Without a key, emails are only written to the outbox + server log ---
RESEND_API_KEY=
EMAIL_FROM="Mountain Retreat <booking@mountainretreat.no>"

# --- Stripe. Without keys, a clearly labelled MOCK payment provider is used (dev only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Vipps ePayment (structure only; requires Vipps merchant agreement) ---
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=

# --- Channel manager (structure only; requires account + API agreement) ---
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=

# --- File storage for photos. Default: local ./storage (use EU S3-compatible bucket in production) ---
STORAGE_DIR=./storage

# Dev only: show a one-click login list on /login (never set in production)
DEV_LOGIN=1
