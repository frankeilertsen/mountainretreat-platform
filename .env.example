# --- Required ---
# Local: postgres://postgres@localhost:5432/byrampen
# Supabase (Vercel): the Transaction pooler string (port 6543) from Supabase → Connect, with ?sslmode=require at the end
DATABASE_URL=postgres://postgres@localhost:5432/byrampen
# Optional with Supabase: the CA certificate (Database settings → SSL → Download certificate) to verify the server
DATABASE_CA_CERT=
# Optional: connections per function instance (default 3 on Vercel, 10 elsewhere)
PG_POOL_MAX=
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Used to encrypt TOTP secrets (AES-256-GCM). Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Separate random secret for hashing tokens (HMAC-SHA256)
TOKEN_PEPPER=
# Shared secret that protects /api/cron/* (send as header x-cron-secret)
CRON_SECRET=

# --- Email (Resend, EU region). Without a key, emails are only written to the outbox + server log ---
RESEND_API_KEY=
EMAIL_FROM="Mountain Retreat <booking@mountainretreat.no>"
# Where replies to the platform's e-mails should go (e.g. your own inbox)
EMAIL_REPLY_TO=frank@mountainretreat.no

# --- Stripe. Without keys, a clearly labelled MOCK payment provider is used (dev only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Vipps ePayment (structure only; requires Vipps merchant agreement) ---
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=

# --- Channel manager (structure only; requires account + API agreement) ---
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=

# --- File storage for photos and PDFs ---
# Supabase Storage (needed on Vercel): project URL + a SECRET key (sb_secret_…, Settings → API Keys). Bucket is created by db/supabase/1-oppsett.sql
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=mountainretreat
# Without Supabase: local folder
STORAGE_DIR=./storage

# --- Optional spam protection with Cloudflare Turnstile instead of the built-in code ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Testing only: show the clearly marked test payment provider in production builds (never with real guests)
# ALLOW_MOCK_PAYMENTS=1

# Dev only: show a one-click login list on /login (never set in production)
DEV_LOGIN=1

# --- SMS (Twilio or Twilio-compatible). Without these, SMS to cleaners is only written to the server log ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
